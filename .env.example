# Bu faylı .env kimi kopyalayıb öz dəyərlərinlə doldur:
#   cp .env.example .env

# --- Məcburi (birini seç) ---
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Bir neçə subscription skan etmək üçün (vergüllə ayrılmış).
# Doldurulubsa, yuxarıdakı tək ID-dən üstün tutulur.
AZURE_SUBSCRIPTION_IDS=

# --- Service Principal (opsional) ---
# Bu üçü doldurulubsa SP ilə autentifikasiya olunur.
# Boş qoyulsa, `az login` sessiyası (AzureCliCredential) istifadə edilir.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Webhook bildirişi (opsional) ---
# Skan bitəndə xülasə göndərilir. Hər ikisi boş olarsa bildiriş göndərilmir.
# Teams varsa ona üstünlük verilir.
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Dashboard parol qoruması (opsional, yalnız demo/local üçün) ---
# Hər ikisi boş olarsa dashboard parolsuz açılır (defolt davranış).
# Hash yaratmaq üçün: python scripts/hash_password.py
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
# Alternativ (daha yavaş, açıq parol saxlayır):
DASHBOARD_PASSWORD=
# Cookie imzası üçün təsadüfi açar - parol qoruması aktivdirsə MƏCBURİDİR
# (boş qalarsa dashboard açılmır). Yaratmaq üçün:
#   python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_COOKIE_KEY=
