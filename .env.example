# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# --- Required (pick one) ---
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# To scan several subscriptions (comma-separated).
# If set, takes precedence over the single ID above.
AZURE_SUBSCRIPTION_IDS=

# --- Service Principal (optional) ---
# If all three are set, authentication uses the SP.
# If left empty, the `az login` session (AzureCliCredential) is used.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Webhook notification (optional) ---
# A summary is sent when the scan finishes. If both are empty, no notification is sent.
# Teams takes precedence if set.
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Dashboard password protection (optional, demo/local only) ---
# If both are empty, the dashboard opens without a password (default behaviour).
# To create a hash: python scripts/hash_password.py
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
# Alternative (slower, stores a plain password):
DASHBOARD_PASSWORD=
# Random key for signing the cookie - REQUIRED if password protection is enabled
# (the dashboard will not open if empty). To generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_COOKIE_KEY=
